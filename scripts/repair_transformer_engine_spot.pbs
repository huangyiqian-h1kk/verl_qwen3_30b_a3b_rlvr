#!/bin/bash
#PBS -P gcg51557
#PBS -q rt_HF
#PBS -l select=1
#PBS -l walltime=04:00:00
#PBS -N repair_te_verl
#PBS -j oe

set -euo pipefail

export WORK=/groups/gcg51557/experiments/0390_rlsd
export PROJ=$WORK/RLVR/verl_qwen3_30b_a3b_rlvr
export ENV_PREFIX=$WORK/envs/verl_qwen3_moe_megatron_py312_cu128
export VERL_SRC=$PROJ/src/verl

source $PROJ/scripts/abci_verl_env.sh
source /home/aci18769hm/opt/miniforge3/etc/profile.d/conda.sh
conda activate $ENV_PREFIX

mkdir -p $PROJ/logs
LOG=$PROJ/logs/repair_transformer_engine_${PBS_JOBID:-manual}_$(date +%F_%H%M%S).log
exec > >(tee -a "$LOG") 2>&1
set -x

echo "===== Job info ====="
date
hostname
module list
which python
python --version
which nvcc
nvcc --version
nvidia-smi

cd $VERL_SRC

echo "===== Current package state ====="
python - <<'PY'
import torch
print("torch:", torch.__version__, torch.version.cuda)
print("cuda available:", torch.cuda.is_available())
print("device count:", torch.cuda.device_count())
try:
    import transformer_engine
    print("transformer_engine already installed:", transformer_engine.__file__)
except Exception as e:
    print("transformer_engine not ready:", repr(e))
PY

echo "===== Make sure cuDNN python package exists before TE build ====="
python -m pip install --no-cache-dir "nvidia-cudnn-cu12==9.10.2.21"

echo "===== Locate cuDNN from python package or ABCI module ====="
read CUDNN_INCLUDE_DIR CUDNN_LIBRARY_DIR CUDNN_LIBRARY <<< "$(python - <<'PY'
import site
from pathlib import Path

candidates = []

for sp in site.getsitepackages():
    p = Path(sp)
    candidates += list(p.glob("nvidia/cudnn/include/cudnn.h"))
    candidates += list(p.glob("nvidia/cudnn*/include/cudnn.h"))

# Fallback to common system/module locations.
for root in [
    Path("/apps/cudnn/9.10.2"),
    Path("/apps/cudnn/9.10"),
    Path("/apps"),
]:
    if root.exists():
        candidates += list(root.glob("**/cudnn.h"))

if not candidates:
    raise SystemExit("Could not locate cudnn.h")

header = candidates[0]
include_dir = header.parent

lib_candidates = []
for base in [include_dir.parent, include_dir.parent.parent]:
    lib_candidates += list(base.glob("lib/libcudnn.so*"))
    lib_candidates += list(base.glob("lib64/libcudnn.so*"))

if not lib_candidates:
    # Try site-packages nvidia/cudnn/lib
    for sp in site.getsitepackages():
        lib_candidates += list(Path(sp).glob("nvidia/cudnn/lib/libcudnn.so*"))
        lib_candidates += list(Path(sp).glob("nvidia/cudnn*/lib/libcudnn.so*"))

if not lib_candidates:
    raise SystemExit("Could not locate libcudnn.so")

lib = sorted(lib_candidates, key=lambda x: len(str(x)))[0]
print(include_dir, lib.parent, lib)
PY
)"

echo "CUDNN_INCLUDE_DIR=$CUDNN_INCLUDE_DIR"
echo "CUDNN_LIBRARY_DIR=$CUDNN_LIBRARY_DIR"
echo "CUDNN_LIBRARY=$CUDNN_LIBRARY"

test -f "$CUDNN_INCLUDE_DIR/cudnn.h"
test -e "$CUDNN_LIBRARY"

export CUDNN_INCLUDE_DIR
export CUDNN_LIBRARY_DIR
export CUDNN_LIBRARY
export LD_LIBRARY_PATH=$CUDNN_LIBRARY_DIR:$LD_LIBRARY_PATH

# Restrict to H200/Hopper arch to reduce compile time.
export CMAKE_CUDA_ARCHITECTURES=90
export CMAKE_ARGS="-DCUDNN_INCLUDE_DIR=${CUDNN_INCLUDE_DIR} -DCUDNN_LIBRARY=${CUDNN_LIBRARY} -DCMAKE_CUDA_ARCHITECTURES=90"
export NVTE_FRAMEWORK=pytorch
export MAX_JOBS=${MAX_JOBS:-16}

echo "===== Clean previous failed build cache ====="
rm -rf $PROJ/.cache/torch_extensions/*
rm -rf $PROJ/.cache/triton/* || true

echo "===== Install TransformerEngine from the same commit seen in verl installer log ====="
python -m pip install --no-cache-dir --no-build-isolation \
  "git+https://github.com/NVIDIA/TransformerEngine.git@c90a720765bc01ebb5ba1f70a7ce2d16b2e46d77"

echo "===== Final import checks ====="
python - <<'PY'
import torch
print("torch:", torch.__version__, torch.version.cuda)
print("cuda available:", torch.cuda.is_available())
print("device count:", torch.cuda.device_count())
if torch.cuda.is_available():
    print("gpu0:", torch.cuda.get_device_name(0))

import transformers
print("transformers:", transformers.__version__)

import vllm
print("vllm:", vllm.__version__)

import megatron.core
print("megatron.core: OK")

import transformer_engine
print("transformer_engine:", transformer_engine.__file__)

try:
    import flash_attn
    print("flash_attn:", flash_attn.__version__)
except Exception as e:
    print("flash_attn import failed:", repr(e))
    raise

import verl
print("verl: OK")
PY

echo "===== pip check ====="
python -m pip check || true

echo "===== Done ====="
date
echo "Log saved to: $LOG"
