#!/bin/bash
#PBS -P gcg51557
#PBS -q rt_HF
#PBS -l select=1
#PBS -l walltime=06:00:00
#PBS -N repair_te_v2
#PBS -j oe

set -euo pipefail

export WORK=/groups/gcg51557/experiments/0390_rlsd
export PROJ=$WORK/RLVR/verl_qwen3_30b_a3b_rlvr
export ENV_PREFIX=$WORK/envs/verl_qwen3_moe_megatron_py312_cu128
export VERL_SRC=$PROJ/src/verl

source $PROJ/scripts/abci_verl_env.sh
source /home/aci18769hm/opt/miniforge3/etc/profile.d/conda.sh
conda activate $ENV_PREFIX

mkdir -p $PROJ/logs
LOG=$PROJ/logs/repair_transformer_engine_v2_${PBS_JOBID:-manual}_$(date +%F_%H%M%S).log
exec > >(tee -a "$LOG") 2>&1
set -x

echo "===== Job info ====="
date
hostname
module list
which python
python --version
which nvcc
nvcc --version
nvidia-smi

cd $VERL_SRC

echo "===== Current package state ====="
python - <<'PY'
import torch
print("torch:", torch.__version__, torch.version.cuda)
print("cuda available:", torch.cuda.is_available())
print("device count:", torch.cuda.device_count())
try:
    import transformer_engine
    print("transformer_engine already installed:", transformer_engine.__file__)
except Exception as e:
    print("transformer_engine not ready:", repr(e))
PY

echo "===== Ensure cuDNN python package exists ====="
python -m pip install --no-cache-dir "nvidia-cudnn-cu12==9.10.2.21"

echo "===== Build cuDNN path variables ====="
export CUDNN_PATH="$(python - <<'PY'
import site
from pathlib import Path

for sp in site.getsitepackages():
    p = Path(sp) / "nvidia" / "cudnn"
    if (p / "include" / "cudnn.h").exists() and (p / "lib").exists():
        print(p)
        raise SystemExit(0)

raise SystemExit("Could not find Python-package cuDNN root")
PY
)"

export CUDNN_ROOT="$CUDNN_PATH"
export CUDNN_HOME="$CUDNN_PATH"
export CUDNN_INCLUDE_DIR="$CUDNN_PATH/include"
export CUDNN_LIBRARY_DIR="$CUDNN_PATH/lib"

# Some CMake scripts search PATH-like variables instead of direct CMake args.
export CPATH="$CUDNN_INCLUDE_DIR:${CPATH:-}"
export C_INCLUDE_PATH="$CUDNN_INCLUDE_DIR:${C_INCLUDE_PATH:-}"
export CPLUS_INCLUDE_PATH="$CUDNN_INCLUDE_DIR:${CPLUS_INCLUDE_PATH:-}"
export LIBRARY_PATH="$CUDNN_LIBRARY_DIR:${LIBRARY_PATH:-}"
export LD_LIBRARY_PATH="$CUDNN_LIBRARY_DIR:${LD_LIBRARY_PATH:-}"
export CMAKE_PREFIX_PATH="$CUDNN_PATH:${CMAKE_PREFIX_PATH:-}"

# TE-specific / CUDA variables.
export CUDA_PATH="$CUDA_HOME"
export NVTE_CUDA_INCLUDE_PATH="$CUDA_HOME/include"
export NVTE_FRAMEWORK=pytorch
export MAX_JOBS=${MAX_JOBS:-8}

echo "CUDNN_PATH=$CUDNN_PATH"
echo "CUDNN_ROOT=$CUDNN_ROOT"
echo "CUDNN_HOME=$CUDNN_HOME"
echo "CUDNN_INCLUDE_DIR=$CUDNN_INCLUDE_DIR"
echo "CUDNN_LIBRARY_DIR=$CUDNN_LIBRARY_DIR"
echo "CUDA_HOME=$CUDA_HOME"
echo "CUDA_PATH=$CUDA_PATH"
echo "NVTE_CUDA_INCLUDE_PATH=$NVTE_CUDA_INCLUDE_PATH"

test -f "$CUDNN_INCLUDE_DIR/cudnn.h"
ls -l "$CUDNN_INCLUDE_DIR/cudnn.h"
ls -l "$CUDNN_LIBRARY_DIR"/libcudnn.so*

echo "===== Clean previous failed local build cache ====="
rm -rf $PROJ/.cache/torch_extensions/* || true
rm -rf $PROJ/.cache/triton/* || true

echo "===== Uninstall broken / partial TE packages if any ====="
python -m pip uninstall -y transformer_engine transformer-engine transformer_engine_torch transformer-engine-torch || true

echo "===== Install TransformerEngine with CUDNN_PATH ====="
python -m pip install --no-cache-dir --no-build-isolation \
  "git+https://github.com/NVIDIA/TransformerEngine.git@c90a720765bc01ebb5ba1f70a7ce2d16b2e46d77"

echo "===== Final import checks ====="
python - <<'PY'
import torch
print("torch:", torch.__version__, torch.version.cuda)
print("cuda available:", torch.cuda.is_available())
print("device count:", torch.cuda.device_count())
if torch.cuda.is_available():
    print("gpu0:", torch.cuda.get_device_name(0))

import transformers
print("transformers:", transformers.__version__)

import vllm
print("vllm:", vllm.__version__)

import megatron.core
print("megatron.core: OK")

import transformer_engine
print("transformer_engine:", transformer_engine.__file__)

import flash_attn
print("flash_attn:", flash_attn.__version__)

import verl
print("verl: OK")
PY

echo "===== pip check ====="
python -m pip check || true

echo "===== Done ====="
date
echo "Log saved to: $LOG"
