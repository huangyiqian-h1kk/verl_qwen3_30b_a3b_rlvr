{
  "schema": "d4-plain-mopd-v1",
  "seed": 42,
  "train_batch_size": 2048,
  "rollout_n": 1,
  "updates": 200,
  "learning_rate": 0.000001,
  "weight_decay": 0.01,
  "adam_betas": [0.9, 0.999],
  "grad_clip": 1.0,
  "pg_signal_clip": 5.0,
  "loss_reduction": "seq-mean-token-mean",
  "save_every": 4,
  "validate_every": 20,
  "max_context_tokens": 65536,
  "student_nodes": 1,
  "gpus_per_node": 8,
  "actor_tp": 2,
  "actor_pp": 2,
  "actor_ep": 2,
  "rollout_tp": 4,
  "teacher_tp": 2,
  "teacher_nodes": 1,
  "max_num_seqs": 16,
  "max_num_batched_tokens": 8192,
  "gpu_memory_utilization": 0.5,
  "poll_seconds": 30
}
